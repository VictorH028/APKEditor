    "editor_syntax_highlighting": true,
    "editor_tabs": true,
    "search_files": true,
    "search_code": true,
    "clear_logs": true,
    "export_logs": true,
    "theme_switching": true,
    "apk_selection": true,
    "resizable_panels": true,
    "progress_updates": true
  },
  "implementation_requirements": {
    "architecture": "modular_component_based",
    "separate_ui_from_business_logic": true,
    "reusable_components": true,
    "responsive_layout": true,
    "real_functionality": true,
    "avoid_static_mockups": true,
    "use_custom_css_or_javafx_stylesheets": true,
    "smooth_animations": true,
    "keyboard_shortcuts": true,
    "preserve_panel_state": true,
    "error_handling": true
  },
  "final_instructions": {
    "priority": [
      "Visual fidelity to reference image",
      "Correct component positioning",
      "Consistent neon color palette",
      "Professional code editor",
      "Functional file explorer",
      "Functional log panel",
      "Modular architecture"
    ],
    "important": [
      "Do not simplify the interface.",
      "Do not replace the dashboard with a generic template.",
      "Preserve the three-column workspace.",
      "Maintain the left navigation sidebar.",
      "Maintain the bottom information panels.",
      "Reproduce the dark futuristic aesthetic.",
      "Use real icons instead of emoji.",
      "Use realistic spacing and proportions.",
      "Implement functional interactions, not just visual elements."
    ]
  }
